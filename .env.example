# ---------------------------------------------------------------------------
#  J.A.R.V.I.S. — plantilla de configuración secreta
# ---------------------------------------------------------------------------
#
#  COPIA este archivo a uno de estos dos sitios y pon tu clave dentro:
#
#      C:\Users\TU_USUARIO\.jarvis\.env      <-- recomendado
#      .env                                  <-- aquí mismo, en el proyecto
#
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore). Este
#  .env.example sí se sube, y por eso no debe contener ninguna clave real.
#
#  Tu clave se saca en:  https://console.anthropic.com/settings/keys
#  Empieza por "sk-ant-". Trátala como una contraseña: quien la tenga puede
#  gastar de tu cuenta.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-pon-aqui-tu-clave


# ---------------------------------------------------------------------------
#  OPCIONAL: voz de ElevenLabs
# ---------------------------------------------------------------------------
#
#  Solo si quieres que hable con una voz de verdad en vez de con la de
#  Windows. Se paga por caracteres hablados y tiene cupo mensual gratuito.
#  Sin esta clave, el asistente funciona igual: habla con la voz del sistema.
#
#  Se saca en:  https://elevenlabs.io/app/settings/api-keys
#  Luego, en el asistente: Ajustes (Ctrl+,) -> Voz -> ElevenLabs.
# ---------------------------------------------------------------------------

# ELEVENLABS_API_KEY=pon-aqui-tu-clave-de-elevenlabs
